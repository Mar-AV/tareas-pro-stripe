# Copia este archivo como .env.local (no lo subas a GitHub).
# Utiliza una clave real de Stripe en modo prueba para probar Checkout.
STRIPE_SECRET_KEY=sk_test_REEMPLAZAR_CON_CLAVE_REAL
# Para la prueba local del script se usa el mismo secreto en ambos lados.
# Para Stripe CLI cambia este valor por el whsec_ que muestra 'stripe listen'.
STRIPE_WEBHOOK_SECRET=whsec_de_prueba_para_el_simulador
NEXT_PUBLIC_URL=http://localhost:3000
